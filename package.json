{
  "name": "dsh-session-folders",
  "version": "0.1.0",
  "description": "DSH 会话归位：每个会话一个时间文件夹，产物不再堆在工作区根目录 / One dated folder per DSH session.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "folder",
    "workspace",
    "file-management",
    "organize"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5"
  },
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/naming.js && node --check lib/note.js && node test/naming.test.mjs && node test/note.test.mjs && node test/plugin.test.mjs"
  },
  "license": "MIT",
  "author": "QAQ-Eleen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QAQ-Eleen/dsh-session-folders.git"
  },
  "bugs": {
    "url": "https://github.com/QAQ-Eleen/dsh-session-folders/issues"
  },
  "homepage": "https://github.com/QAQ-Eleen/dsh-session-folders#readme",
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
